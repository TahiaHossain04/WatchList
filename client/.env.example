# ---------------------------------------------------------------
# Tahia's Watch List — client environment
# Copy this file to `client/.env` and fill in the values.
# ---------------------------------------------------------------

# Supabase project URL + ANON (public) key. The anon key is safe in the browser:
# Row Level Security only lets it READ entries. Never put the service-role key here.
# Leave both empty to run in DEMO MODE (log in with password "demo").
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Only needed in production if the API lives on a different domain than the site.
# In development, Vite proxies /api to http://localhost:4000 automatically.
VITE_API_URL=
