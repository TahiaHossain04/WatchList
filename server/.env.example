# ---------------------------------------------------------------
# Tahia's Watch List — server environment
# Copy this file to `server/.env` and fill in the values.
# NEVER commit the real .env file.
# ---------------------------------------------------------------

PORT=4000

# Where the React app runs (used for CORS). Comma-separate multiple origins.
CLIENT_ORIGIN=http://localhost:5173

# Supabase project settings (Project Settings -> API).
# If these are left empty the server runs in DEMO MODE with in-memory sample data.
SUPABASE_URL=
# The service-role key is SECRET. It lives only on the server, never in the client.
SUPABASE_SERVICE_ROLE_KEY=

# The only account allowed to create / edit / delete entries.
ADMIN_EMAIL=

# Future: TMDB metadata search (kept server-side so the key is never exposed).
TMDB_API_KEY=
